VITE_API_BASE_URL=https://msplapi.ridenimbo.com
# Dedicated workspace backends. Keep Training on its own backend and isolated database.
VITE_LIVE_API_BASE_URL=https://msplapi.ridenimbo.com/
VITE_TRAINING_API_BASE_URL=https://msplapi.ridenimbo.com/
VITE_APP_NAME=MSPL Assist
VITE_APP_VERSION=1.0.0
# Set to training only for a build deployed against the dedicated Training database.
VITE_MSPL_RUNTIME_ENV=production
# Rental admin UserService. Create-ticket step 1 calls this when searching a rider.
VITE_RENTAL_GET_ALL_USERS_URL=http://10.100.111.1:6063/UserService/User/GetAllUsers
# Optional. UserService requires Authorization: Bearer <rental admin JWT>.
VITE_RENTAL_USERS_API_TOKEN=
# Bookings for the selected rental user. The user id is appended, for example /40.
VITE_RENTAL_GET_BOOKINGS_BY_USER_URL=http://localhost:5158/Booking/GetBookingsByUserId
