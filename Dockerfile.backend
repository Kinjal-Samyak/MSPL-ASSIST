# ---- Stage 1: build ---------------------------------------------------
# IMPORTANT: this repo is NOT an npm workspaces monorepo. The root
# package.json (name: "tanstack_start_ts") is an unrelated scaffold with no
# "workspaces" field and no "build:shared" script - it is not involved in
# building MSPL Assist at all. backend/ and frontend/ are independent
# packages that pull in the @mspl/* packages under packages/* via plain
# `file:../packages/x` dependencies. npm installs a `file:` dependency as a
# SYMLINK, not a copy - so at runtime, backend/node_modules/@mspl/x is a
# symlink pointing back to ../../packages/x, which means the actual built
# packages/ directory has to exist in the final image too, not just
# backend/node_modules. See the production stage below.
FROM node:20-alpine AS build
WORKDIR /app
RUN apk add --no-cache openssl

# None of the packages/* packages declare their own `typescript`
# devDependency (confirmed: `npm install` inside each reports "audited 1
# package" - itself only). Locally this has been working by accident: npm's
# script runner walks up ancestor directories collecting node_modules/.bin,
# so tsc from the unrelated root scaffold's node_modules gets picked up.
# There's no such ancestor here, so install tsc globally once instead.
# The real fix is for each packages/* package to declare its own
# typescript devDependency - worth raising with whoever owns the app.
# typescript pinned to match backend/package.json and frontend/package.json
# (both use ^5.5.4) - installing latest breaks here, since packages/*'s
# tsconfig.json still uses `moduleResolution: "node10"`, an option that was
# fully removed in newer TypeScript versions (TS5108). Every other
# package.json in this repo already pins an older typescript for this
# reason; this one just needs to match.
RUN npm install -g typescript@5.5.4

# Only copy what's needed to build the shared packages first, for layer
# caching - the full backend/ source is copied further down.
COPY packages ./packages

# Build order: shared-constants and shared-types have no @mspl/* deps of
# their own (confirmed - neither declares a "dependencies" block), so they
# can build in any order. conversation-workflow depends on both, so it
# builds last. shared-utils and shared-validation are also dependency-free
# leaf packages; shared-utils is required by backend, shared-validation
# currently isn't but costs nothing to build here too.
RUN cd packages/shared-constants && npm install && npm run build
RUN cd packages/shared-types && npm install && npm run build
RUN cd packages/shared-utils && npm install && npm run build
RUN cd packages/shared-validation && npm install && npm run build
RUN cd packages/conversation-workflow && npm install && npm run build

# Now bring in the backend source and install it. This install is what
# links the file:../packages/* dependencies (as symlinks) into
# backend/node_modules - it must happen after the packages above are built.
COPY backend ./backend
WORKDIR /app/backend
RUN npm install --include=dev
RUN npm run prisma:generate
RUN npm run build

# ---- Stage 2: production runtime --------------------------------------
FROM node:20-alpine AS production
WORKDIR /app/backend
ENV NODE_ENV=production
RUN apk add --no-cache openssl

# The built packages/ directory has to land at /app/packages - the same
# relative position it occupied during build - because backend/node_modules
# contains symlinks (e.g. @mspl/shared-utils -> ../../packages/shared-utils)
# that resolve relative to this path structure.
COPY --from=build /app/packages ./../packages

COPY --from=build /app/backend/package*.json ./
COPY --from=build /app/backend/node_modules ./node_modules
COPY --from=build /app/backend/dist ./dist
COPY --from=build /app/backend/prisma ./prisma

EXPOSE 4000
CMD ["npm", "run", "start"]
