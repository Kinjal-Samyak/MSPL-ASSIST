{
  "expo": {
    "name": "MSPL Assist",
    "slug": "mspl-assist-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.msplassist.mobile"
    },
    "android": {
      "package": "com.msplassist.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "MSPL Assist uses the camera to capture evidence photos for job records."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MSPL Assist uses your photo library to attach existing evidence photos to job records."
        }
      ]
    ]
  }
}
