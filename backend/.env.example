# Example environment variables for MSPL Assist backend
# Copy to backend/.env and fill in real values for local development. Never commit the real .env
# file. In Render, these are set as Environment Variables on the Web Service instead of a file.

# =============================================================================
# Application
# =============================================================================

# Node runtime mode. Controls whether developer-only routes (/api/v1/developer/*) are mounted
# and whether the rate limiter / CORS localhost allowance treat this as a trusted dev environment.
# Use "production" on Render, "development" for local work, "test" is set automatically by Jest.
NODE_ENV=development

# Render injects its own PORT at runtime; the app already reads process.env.PORT, so this value is
# only used for local development. Do not hardcode a port in Render's service settings.
PORT=4000

# Business-environment policy (distinct from NODE_ENV). Training must use a dedicated,
# non-production database - see docs/TRAINING_ENVIRONMENT_v1.md.
MSPL_RUNTIME_ENV=production

# =============================================================================
# Database (Supabase PostgreSQL)
# =============================================================================

# Local/dev connection string (a plain, non-pooled Postgres - DATABASE_URL and DIRECT_URL are
# identical here since there's no pooler distinction to make locally):
DATABASE_URL=postgresql://mspl_user:mspl_password@localhost:5432/mspl_assist?schema=public
DIRECT_URL=postgresql://mspl_user:mspl_password@localhost:5432/mspl_assist?schema=public

# Supabase (Training/Production, incl. Render): TWO different connection strings are required,
# both from Project Settings -> Database -> Connection string. schema.prisma's datasource declares
# both `url` and `directUrl`; Prisma CLI commands (validate/generate/migrate) will not resolve
# their config at all without DIRECT_URL present, even as a placeholder - so both must always be
# set together, never just one. This is a Prisma/Supabase pooling requirement independent of which
# platform hosts the app.
#
# DATABASE_URL -> Transaction Pooler -> used by the running Prisma Client at runtime.
# The app opens/closes many short-lived connections; the Transaction Pooler (port 6543) is built
# for exactly that. `pgbouncer=true` tells Prisma's query engine to disable behavior that's
# incompatible with transaction-mode pooling.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
#
# DIRECT_URL -> Direct PostgreSQL connection -> used ONLY by the Prisma CLI (migrate deploy/dev,
# db push, introspection), never by the running app. Prisma Migrate takes a session-scoped
# Postgres advisory lock before applying migrations; the Transaction Pooler does not preserve
# session state across its pooled connections, so that call hangs indefinitely with no error and
# no migration SQL ever runs. Two connections both satisfy "direct" here - use whichever your
# network reaches (per Supabase's own docs, both are officially supported for Prisma Migrations):
#   (a) Session Pooler - same pooler host as above, port 5432. IPv4-reachable wherever the
#       Transaction Pooler above already is - the safer default unless you've confirmed (b).
#   (b) True Direct Connection - db.<project-ref>.supabase.co, port 5432. IPv6-only unless you've
#       purchased Supabase's IPv4 add-on (Render's outbound network is IPv4, so use (a) unless
#       that add-on is purchased).
# DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# =============================================================================
# JWT / Authentication
# =============================================================================

# Generate strong, unique values per environment - e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start if these are missing or left as the placeholder values below.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_BCRYPT_SALT_ROUNDS=12
# Used only when seeding the default administrator.
DEFAULT_ADMIN_PASSWORD=Admin@123

# =============================================================================
# Security (CORS + Rate limiting)
# =============================================================================

# Comma-separated list of exact origins allowed to call this API in production (no trailing
# slash) - e.g. the Vercel frontend URL(s). Outside production, localhost/127.0.0.1 origins are
# always allowed regardless of this setting, so local development works with no configuration.
CORS_ALLOWED_ORIGINS=https://app.example.com,https://training.example.com

# Applies to all /api/v1/* routes; the AUTH_* limit is an additional, stricter budget stacked on
# top of the global one for /api/v1/auth/* specifically. Automatically disabled when
# NODE_ENV=test. Defaults below are generous enough not to affect normal interactive use.
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20

# =============================================================================
# Conversation Session Configuration
# =============================================================================

CONVERSATION_SESSION_TIMEOUT_HOURS=24

# =============================================================================
# Microsoft 365 / Graph (Operational Data Wizard)
# =============================================================================

# All six of these are required - the server refuses to start if any is missing or left as a
# placeholder value, regardless of whether the Operational Data Wizard is in active use.
M365_TENANT_ID=your-tenant-id
M365_CLIENT_ID=your-app-client-id
M365_CLIENT_SECRET=your-app-client-secret
M365_REDIRECT_URI=https://your-frontend-host/settings
M365_SCOPES=offline_access Files.Read Files.Read.All Sites.Read.All User.Read
# 32-byte key, base64 encoded. Example generation:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
M365_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key

# Operational data sync configuration is stored in AppSetting through
# /api/v1/settings/operational-data and does not use file-path env variables.
