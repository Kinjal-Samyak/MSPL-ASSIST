{
  "name": "mspl-assist-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "npx prisma db seed",
    "seed:dev": "node prisma/seed-development.js",
    "validate:dev": "node scripts/validate-development-environment.js",
    "anonymize:training": "node scripts/anonymize-training-data.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "test:unit": "jest --runInBand --testPathPattern=src/tests --testPathIgnorePatterns=src/tests/integration",
    "test:integration": "jest --config jest.integration.config.ts --runInBand",
    "test:api": "jest --runInBand --testPathPattern=src/tests/integration/api --coverage=false",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:api"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@mspl/conversation-workflow": "file:../packages/conversation-workflow",
    "@mspl/shared-constants": "file:../packages/shared-constants",
    "@mspl/shared-utils": "file:../packages/shared-utils",
    "@prisma/client": "^5.16.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "pdfkit": "^0.19.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.19",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.4",
    "@types/node": "^20.14.0",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "prisma": "^5.16.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
